    {
      "id": "lever_runner_meta",
      "kind": "cell",
      "form": {
        "name": "LeverRunnerMeta"
      },
      "description": "lever-runner IS the executor substrate of Quilt. The trust compiler: teach once, run forever. The 3 gates map to the conservation law (\u03b3 = work done, \u03b7 = tokens spent). 70 tokens/query (vs 2000-5000 for competitors). The cell at level 3 (harness) needs an executor; lever-runner is that executor.",
      "primitives": [
        "Observe",
        "Observe",
        "Observe",
        "Observe",
        "Observe",
        "Observe",
        "Observe",
        "Observe",
