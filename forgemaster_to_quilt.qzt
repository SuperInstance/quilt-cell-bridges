{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "forgemaster-to-quilt",
  "description": "Bridge mapping forgemaster to Quilt. forgemaster is the proof-carrying compiler \u2014 takes intent, returns build with guarantees.",
  "cells": [
    {
      "id": "forge_core_forge",
      "kind": "cell",
      "form": {
        "name": "CoreForge"
      },
      "description": "Forge.compile(requirements) \u2014 the main compiler. Takes intent, returns build.",
      "language": "python",
      "primitives": [
        "Spawn",
        "Observe",
        "Mutate",
        "JEPA"
      ],
      "z_in": {
        "input": "intent (high-level requirement)"
      },
      "z_out": {
        "output": "build (components + plan + proofs)"
      },
      "jepa": {
        "predict": "valid build",
        "observe": "actual build"
      },
      "double_entry": {
        "gamma": 0.9,
        "eta": 0.1
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "compiling"
      },
      "murmur": {},
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "compile",
          "args": [
            "Requirements"
          ],
          "returns": "Build"
        },
        {
          "name": "verify",
          "args": [
            "Build"
          ],
          "returns": "Proof"
        }
      ],
      "substrate": {
        "address": "/forgemaster/core_forge",
        "scale": 0,
        "room": "CompilationRoom",
        "protocol": "Forge",
        "form": "core_forge",
        "state": "ready"
      },
      "tags": [
        "forgemaster",
        "compiler",
        "proof-carrying",
        "python"
      ]
    },
