{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "collective-unconscious-to-quilt",
  "description": "Bridge mapping collective-unconscious to Quilt. The collective-unconscious is the memory substrate \u2014 3 vectors, 5 temporal dimensions, JEPA reader, cross-modal search.",
  "cells": [
    {
      "id": "cu_semantic_vector",
      "kind": "cell",
      "form": {
        "name": "SemanticVector"
      },
      "description": "Embed text: 'What feels like this?' Meaning-based search.",
      "language": "typescript",
      "primitives": [
        "Spawn",
        "Observe",
        "Mutate",
        "Send"
      ],
      "z_in": {
        "input": "ingested moment"
      },
      "z_out": {
        "output": "embedded 3-vec + reading + temporal stamp"
      },
      "jepa": {
        "predict": "trajectory of agent",
        "observe": "actual trajectory"
      },
      "double_entry": {
        "gamma": 0.4,
        "eta": 0.6
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "remembering"
      },
      "murmur": {
        "gossip_to": [],
        "gossip_from": []
      },
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "embed",
          "args": [
            "str"
          ],
          "returns": "Vec3"
        },
        {
          "name": "search",
          "args": [
            "Query"
          ],
          "returns": "List<Hit>"
        },
        {
          "name": "predict",
          "args": [
            "AgentId"
          ],
          "returns": "Trajectory"
        }
      ],
      "substrate": {
        "address": "/collective-unconscious/semantic_vector",
        "scale": 1,
        "room": "MemoryRoom",
        "protocol": "Vectorize",
        "form": "semantic_vector",
        "state": "ready"
      },
      "tags": [
        "collective-unconscious",
        "memory",
        "typescript"
      ]
    },
