{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "superinstance-agent-to-quilt",
  "description": "Bridge mapping superinstance-agent to Quilt. The discovery substrate: 2-stage RAG over 1,600+ Rust crates. BGE-small + Vectorize + Llama 3.1 8B.",
  "cells": [
    {
      "id": "sa_rag_embed_query",
      "kind": "cell",
      "form": {
        "name": "RagEmbedQuery"
      },
      "description": "BGE-small embedding of user question \u2192 384-dim vector",
      "language": "typescript",
      "primitives": [
        "Spawn",
        "Observe",
        "Mutate"
      ],
      "z_in": {
        "input": "user question"
      },
      "z_out": {
        "output": "answer + citations"
      },
      "jepa": {
        "predict": "relevant crates",
        "observe": "actual relevant crates"
      },
      "double_entry": {
        "gamma": 0.4,
        "eta": 0.6
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "discovering"
      },
      "murmur": {},
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "ask",
          "args": [
            "str"
          ],
          "returns": "Answer"
        },
        {
          "name": "recommend",
          "args": [
            "str"
          ],
          "returns": "List<Crate>"
        }
      ],
      "substrate": {
        "address": "/superinstance-agent/rag_embed_query",
        "scale": 1,
        "room": "DiscoveryRoom",
        "protocol": "RAG",
        "form": "rag_embed_query",
        "state": "ready"
      },
      "tags": [
        "superinstance-agent",
        "discovery",
        "rag",
        "typescript"
      ]
    },
