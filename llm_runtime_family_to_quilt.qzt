{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "llm-runtime-family-to-quilt",
  "description": "Bridge mapping 14 LLM runtime repos to Quilt. The language model substrate: Claude, Claw, Businesslog.",
  "cells": [
    {
      "id": "llm_claude",
      "kind": "cell",
      "form": {
        "name": "Claude"
      },
      "description": "Core Claude integration. The cell talks to Claude.",
      "language": "python",
      "slug": "claude",
      "primitives": [
        "Spawn",
        "Send",
        "Receive",
        "JEPA"
      ],
      "z_in": {
        "input": "LLM prompt, business event"
      },
      "z_out": {
        "output": "LLM response, log entry"
      },
      "jepa": {
        "predict": "next LLM token",
        "observe": "actual"
      },
      "double_entry": {
        "gamma": 0.3,
        "eta": 0.7
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "active"
      },
      "murmur": {},
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "ask",
          "args": [
            "Prompt"
          ],
          "returns": "Response"
        },
        {
          "name": "log",
          "args": [
            "Event"
          ],
          "returns": "Unit"
        }
      ],
      "substrate": {
        "address": "/llm-runtime/claude",
        "scale": 0,
        "room": "LLMRoom",
        "protocol": "LLM",
        "form": "claude",
        "state": "ready"
      },
      "tags": [
        "llm-runtime",
        "claude",
        "claw",
        "businesslog",
        "python"
      ]
    },
