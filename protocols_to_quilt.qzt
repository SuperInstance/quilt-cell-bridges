{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "protocols-to-quilt",
  "description": "Bridge mapping 21 protocol repos to Quilt. A2A + A2UI + Baton + API tools.",
  "cells": [
    {
      "id": "proto_a2a_adapter",
      "kind": "cell",
      "form": {
        "name": "A2AAdapter"
      },
      "description": "Adapter for A2A protocol. The cell speaks A2A.",
      "language": "typescript",
      "slug": "adapter",
      "primitives": [
        "Spawn",
        "Send",
        "Receive",
        "Murmur"
      ],
      "z_in": {
        "input": "protocol message"
      },
      "z_out": {
        "output": "protocol response, UI render, baton handoff"
      },
      "jepa": {
        "predict": "next protocol step",
        "observe": "actual"
      },
      "double_entry": {
        "gamma": 0.5,
        "eta": 0.5
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "active"
      },
      "murmur": {},
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "speak",
          "args": [
            "Message"
          ],
          "returns": "Response"
        }
      ],
      "substrate": {
        "address": "/protocols/a2a-adapter",
        "scale": 0,
        "room": "ProtocolRoom",
        "protocol": "a2a-adapter",
        "form": "a2a-adapter",
        "state": "ready"
      },
      "tags": [
        "protocols",
        "a2a",
        "a2ui",
        "baton",
        "api",
        "typescript"
      ]
    },
