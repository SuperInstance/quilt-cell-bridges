{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "mud-family-to-quilt",
  "description": "Bridge mapping the 13 MUD family repos to Quilt. The MUD family IS the spatial substrate: rooms, worlds, NPC agents, training grounds.",
  "cells": [
    {
      "id": "mud_mud_arena",
      "kind": "cell",
      "form": {
        "name": "MudArena"
      },
      "description": "Flow-state engineering arena \u2014 agents run forward simulation",
      "language": "python",
      "slug": "arena",
      "primitives": [
        "Spawn",
        "Observe",
        "Mutate",
        "Send",
        "JEPA"
      ],
      "z_in": {
        "input": "command from agent or user"
      },
      "z_out": {
        "output": "room state, NPC response, world event"
      },
      "jepa": {
        "predict": "next room state",
        "observe": "actual state"
      },
      "double_entry": {
        "gamma": 0.5,
        "eta": 0.5
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "active"
      },
      "murmur": {
        "gossip_to": [],
        "gossip_from": []
      },
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "enter",
          "args": [
            "Agent"
          ],
          "returns": "Room"
        },
        {
          "name": "say",
          "args": [
            "str"
          ],
          "returns": "Responses"
        },
        {
          "name": "move",
          "args": [
            "Direction"
          ],
          "returns": "Room"
        }
      ],
      "substrate": {
        "address": "/mud/mud-arena",
        "scale": 1,
        "room": "MudRoom",
        "protocol": "MUD",
        "form": "mud-arena",
        "state": "active"
      },
      "tags": [
        "mud",
        "spatial",
        "room",
        "python",
        "arena"
      ]
    },
