{
  "version": "1.0",
  "kind": "quilt-zip-target",
  "name": "collective-context-to-quilt",
  "description": "Bridge mapping 14 collective+context repos to Quilt. The swarm intelligence + memory management substrate.",
  "cells": [
    {
      "id": "colctx_collective_ai",
      "kind": "cell",
      "form": {
        "name": "CollectiveAi"
      },
      "description": "Swarm AI. Many minds, one answer.",
      "language": "python",
      "slug": "swarm-ai",
      "primitives": [
        "Spawn",
        "Observe",
        "Murmur"
      ],
      "z_in": {
        "input": "context, swarm signal"
      },
      "z_out": {
        "output": "compacted context, swarm answer"
      },
      "jepa": {
        "predict": "next context state",
        "observe": "actual"
      },
      "double_entry": {
        "gamma": 0.4,
        "eta": 0.6
      },
      "vibe": {
        "position": 0,
        "velocity": 0,
        "acceleration": 0
      },
      "gc": {
        "phase": "active"
      },
      "murmur": {
        "gossip_to": [],
        "gossip_from": []
      },
      "graph": {
        "parents": [],
        "children": []
      },
      "openers": [
        {
          "name": "process",
          "args": [
            "Context"
          ],
          "returns": "Result"
        }
      ],
      "substrate": {
        "address": "/collective-context/collective-ai",
        "scale": 1,
        "room": "CollectiveContextRoom",
        "protocol": "Swarm",
        "form": "collective-ai",
        "state": "ready"
      },
      "tags": [
        "collective",
        "context",
        "swarm",
        "python"
